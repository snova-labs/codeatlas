{
  "name": "codeatlas/analyzer-routes",
  "description": "CodeAtlas route analyzer — extracts Laravel routes via AST.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "codeatlas",
    "analyzer",
    "routes",
    "laravel"
  ],
  "authors": [
    {
      "name": "Jay Patel",
      "email": "novaprime-code@users.noreply.github.com",
      "homepage": "https://github.com/novaprime-code",
      "role": "Core Contributors"
    },
    {
      "name": "Ishwari Raut",
      "email": "snova-code@users.noreply.github.com",
      "homepage": "https://github.com/snova-code",
      "role": "Core Contributors"
    }
  ],
  "support": {
    "issues": "https://github.com/snova-labs/codeatlas/issues",
    "source": "https://github.com/snova-labs/codeatlas"
  },
  "require": {
    "php": "^8.3",
    "codeatlas/contracts": "@dev",
    "codeatlas/core": "@dev"
  },
  "require-dev": {
    "pestphp/pest": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "CodeAtlas\\Analyzers\\Routes\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodeAtlas\\Analyzers\\Routes\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
