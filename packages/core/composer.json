{
  "name": "codeatlas/core",
  "description": "CodeAtlas core engine  container, config, plugin loader, event bus, pipeline runner, and AST parser wrapper.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "codeatlas",
    "core",
    "static-analysis",
    "ast",
    "visualization"
  ],
  "authors": [
    {
      "name": "Jay Patel",
      "email": "novaprime-code@users.noreply.github.com",
      "homepage": "https://github.com/novaprime-code",
      "role": "Core Contributors"
    },
    {
      "name": "Ishwari Raut",
      "email": "snova-code@users.noreply.github.com",
      "homepage": "https://github.com/snova-code",
      "role": "Core Contributors"
    }
  ],
  "support": {
    "issues": "https://github.com/snova-labs/codeatlas/issues",
    "source": "https://github.com/snova-labs/codeatlas"
  },
  "require": {
    "php": "^8.3",
    "codeatlas/contracts": "^0.1.0",
    "nikic/php-parser": "^5.3",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "pestphp/pest": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "CodeAtlas\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodeAtlas\\Core\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
