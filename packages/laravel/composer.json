{
  "name": "codeatlas/laravel",
  "description": "CodeAtlas Laravel bridge — ServiceProvider, artisan commands, and embedded web UI for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "codeatlas",
    "laravel",
    "architecture",
    "visualization",
    "static-analysis",
    "php"
  ],
  "authors": [
    {
      "name": "Jay Patel",
      "email": "novaprime-code@users.noreply.github.com",
      "homepage": "https://github.com/novaprime-code",
      "role": "Core Contributors"
    },
    {
      "name": "Ishwari Raut",
      "email": "snova-code@users.noreply.github.com",
      "homepage": "https://github.com/snova-code",
      "role": "Core Contributors"
    }
  ],
  "support": {
    "issues": "https://github.com/snova-labs/codeatlas/issues",
    "source": "https://github.com/snova-labs/codeatlas"
  },
  "require": {
    "php": "^8.3",
    "codeatlas/analyzer-routes": "^0.1.0",
    "codeatlas/contracts": "^0.1.0",
    "codeatlas/core": "^0.1.0",
    "codeatlas/exporter-json": "^0.1.0",
    "codeatlas/scanner": "^0.1.0",
    "illuminate/console": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "pestphp/pest": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "CodeAtlas\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodeAtlas\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CodeAtlas\\Laravel\\CodeAtlasServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
